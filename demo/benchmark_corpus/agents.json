              ],
              "Resource": "arn:aws:logs:us-east-1:123456789012:log-group:*"
            },
            {
              "Effect": "Allow",
              "Action": "s3:PutObject",
              "Resource": "arn:aws:s3:::acme-siem-intake/*"
            },
            {
              "Effect": "Allow",
              "Action": "sts:AssumeRole",
              "Resource": "arn:aws:iam::987654321098:role/SIEMIngestion"
